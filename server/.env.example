# In Good Hands - server environment variables
#
# Copy this file to server/.env and fill in real values. Never commit server/.env.
# Alternatively, run `npm run dev:server:infisical` from the repo root to have the
# Infisical CLI inject these as process env vars without writing anything to disk.
#
# Loaded by `require('dotenv').config()` at the top of server/index.js.
# Every name below is read somewhere in server/; the source location is noted.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. Read in server/db/database.js.
# Defaults to an empty string if unset, so the server cannot connect.
DATABASE_URL=postgresql://user:password@localhost:5432/database

# Secret used to sign and verify session JWTs. Resolved once in
# server/lib/jwtSecret.js; every route and middleware imports it from there.
# The server REFUSES TO START without it on anything it cannot positively
# identify as a local development machine. On a local machine it falls back to
# a shared dev value with a warning, so set it locally anyway.
# Deliberately left EMPTY. The guard keys on falsiness, so a non-empty
# placeholder copied straight from this template would be accepted as a real
# secret and the server would start with a value published in this repo.
JWT_SECRET=

# Origin allowed by CORS. Read in server/index.js.
# This is the ONLY var controlling CORS. If it is unset at runtime the
# middleware reflects whatever Origin the request sends, with
# Access-Control-Allow-Credentials: true, letting any site make authenticated
# requests to the API. Always set it.
CLIENT_URL=http://localhost:5173

# --- Cloudflare R2 file storage (required for uploads) ----------------------
# All four are read in server/lib/r2.js.
# Note: R2_ENDPOINT is what the code reads, not R2_ACCOUNT_ID.

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-bucket-name

# --- Email (optional; features degrade rather than fail) --------------------

# Resend API key. Read in server/lib/sendEmail.js.
# If unset, outbound email is skipped with a console warning.
RESEND_API_KEY=replace-with-resend-api-key

# Sender address. Read in server/lib/sendEmail.js.
# Falls back to "In Good Hands <onboarding@resend.dev>" if unset.
FROM_EMAIL=In Good Hands <noreply@yourdomain.com>

# Destination for contact-form notifications. Read in server/routes/contact.js.
# Falls back to admin@igh.local if unset. Also used as the fallback destination
# for the initial admin password email below.
ADMIN_EMAIL=admin@igh.local

# Where to email the generated admin password when a NEW database is seeded.
# Read in server/db/database.js. Overrides ADMIN_EMAIL for that one purpose.
# Only ever fires on a database that has no admin@igh.local yet, so it is silent
# on an existing environment. Requires RESEND_API_KEY; the password is printed
# to the server log either way.
ADMIN_SEED_NOTIFY_EMAIL=

# --- Stripe billing (optional; only needed to exercise billing) -------------

# Read in server/lib/stripe.js. Throws when a billing path is hit if unset.
STRIPE_SECRET_KEY=sk_test_replace_me

# Read in server/routes/stripeWebhook.js. Only needed to verify webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Price IDs read in server/lib/stripe.js.
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_ANNUAL=price_replace_me

# Org/funeral-home portal price IDs, read in server/lib/orgPlanLimits.js.
STRIPE_ORG_PRICE_PROFESSIONAL=price_replace_me
STRIPE_ORG_PRICE_GROWTH=price_replace_me

# --- Optional ---------------------------------------------------------------

# Read in server/index.js. Set to exactly "true" to register the
# org/funeral-home portal routes. Any other value, or unset, leaves those
# routes unregistered entirely rather than merely auth-rejected (SEC-12).
# Unset in production; set to true on staging and local dev.
# Left unset deliberately: unset is the safe default (routes not registered at
# all, SEC-12). Uncomment only on staging or local dev.
# ORG_PORTAL_ENABLED=true

# Sentry error reporting. Read in server/instrument.js. Sentry is skipped if unset.
SENTRY_DSN=

# HTTP port. Read in server/index.js. Defaults to 3001.
PORT=3001

# Standard Node environment flag. Read in 6 places, including the
# JWT_SECRET startup guard in server/middleware/auth.js.
NODE_ENV=development

# --- Platform-injected, do not set locally ----------------------------------
# RENDER_SERVICE_NAME is supplied by Render and read in server/instrument.js
# and server/lib/backup.js to label the environment.
